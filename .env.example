# ---------- Servidor (apps/server) ----------
# Porta HTTP/WebSocket do servidor de jogo
PORT=3001
# Origens autorizadas a abrir conexão (CORS), separadas por vírgula
CORS_ORIGINS=http://localhost:5173
# Nível de log: debug | info | warn | error
LOG_LEVEL=info
# Tempo máximo (segundos) para o jogador agir antes da jogada automática
TURN_TIMEOUT_SECONDS=30

# ---------- Web (apps/web) ----------
# URL pública do servidor de jogo (variáveis VITE_ ficam expostas no navegador — nada sensível aqui)
VITE_SERVER_URL=http://localhost:3001

# ---------- Docker local (docker-compose.yml) ----------
# Porta do frontend no host (opcional; padrao 5173). Se mudar, inclua a nova origem em CORS_ORIGINS.
# WEB_PORT=5173
