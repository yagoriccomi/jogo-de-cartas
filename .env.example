# ---------- Servidor (apps/server) ----------
# Porta HTTP/WebSocket do servidor de jogo
PORT=3001
# Origens autorizadas a abrir conexão (CORS), separadas por vírgula
CORS_ORIGINS=http://localhost:5173
# Nível de log: debug | info | warn | error
LOG_LEVEL=info
# Milissegundos que o bot espera antes de jogar (padrão 2000)
# BOT_DELAY_MS=2000
# Só desenvolvimento: libera cenários de teste (mesa com 10 jogadores e muitas cartas). Padrão false;
# o docker-compose de desenvolvimento já liga. NUNCA habilitar em produção.
# CENARIOS_DE_TESTE=false
# Opcional: banco do histórico das partidas (Turso/libSQL). Sem ela, nada é gravado e o jogo roda igual.
# Local, sem conta: file:./dados/fodinha.db (fica em apps/server/dados/, fora do Git).
# Produção: libsql://<banco>.turso.io
TURSO_DATABASE_URL=
# Token do Turso (segredo: nunca versionar). O arquivo local não precisa.
TURSO_AUTH_TOKEN=
# Opcional: login com Google (Better Auth). Liga só com as quatro preenchidas E com TURSO_DATABASE_URL
# (as sessões ficam no mesmo banco). Todas vazias = login desligado; só parte delas = o servidor não sobe.
# Passo a passo do cliente OAuth no README (seção "Login com Google").
# ID do cliente OAuth "Aplicativo da Web" no Google Cloud
GOOGLE_CLIENT_ID=
# Chave secreta do cliente OAuth (segredo: nunca versionar)
GOOGLE_CLIENT_SECRET=
# Segredo das sessões, 32 caracteres ou mais: openssl rand -base64 32 (segredo; um por ambiente)
BETTER_AUTH_SECRET=
# Endereço público do servidor; a volta do Google é <BETTER_AUTH_URL>/api/auth/callback/google
# Dev: http://localhost:3001 · Produção: https://fodinha-server-2sg2.onrender.com
BETTER_AUTH_URL=

# ---------- Web (apps/web) ----------
# URL pública do servidor de jogo (variáveis VITE_ ficam expostas no navegador — nada sensível aqui)
VITE_SERVER_URL=http://localhost:3001

# ---------- Docker local (docker-compose.yml) ----------
# Porta do frontend no host (opcional; padrao 5173). Se mudar, inclua a nova origem em CORS_ORIGINS.
# WEB_PORT=5173
