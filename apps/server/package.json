{
  "name": "@fodinha/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "tsup",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "simular": "esbuild test/simulacao/simular-em-paralelo.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/simulacao/simular.mjs && node node_modules/.cache/simulacao/simular.mjs",
    "exportar-treino": "tsx --env-file-if-exists=../../.env src/exportar-treino.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fodinha/shared": "*",
    "@libsql/client": "^0.18.0",
    "better-auth": "^1.7.12",
    "fastify": "^5.2.0",
    "kysely": "^0.29.7",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "socket.io-client": "^4.8.1",
    "tsup": "^9.0.0",
    "tsx": "^4.19.2",
    "vitest": "^5.0.4"
  }
}
