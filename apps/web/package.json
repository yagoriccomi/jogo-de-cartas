{
  "name": "@fodinha/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cliente web do Fodinha (React + Vite). Só renderiza o estado recebido do servidor e emite intenções.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fodinha/shared": "*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
